# Supabase (safe for browser — anon key only, never service role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloud coordination backend
NEXT_PUBLIC_CLOUD_API_URL=http://localhost:8000
# Optional failover backend — used automatically when the primary is down
NEXT_PUBLIC_CLOUD_API_URL_BACKUP=

# Desktop app download (GitHub "latest release" URL always serves the newest asset)
NEXT_PUBLIC_AGENT_DOWNLOAD_URL=https://github.com/HenryEmmanuel06/netsyncai/releases/latest/download/netsync-agent.exe
