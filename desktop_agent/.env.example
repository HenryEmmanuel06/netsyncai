# OPTIONAL dev overrides — the shipped exe does not need a .env.
# Production URL is baked in via build_config.json (see docs/DEPLOYMENT.md).
# These are read from the real process environment, not loaded from this file:
#   $env:NETSYNC_COORDINATOR_URL = "http://localhost:8000"
#   $env:NETSYNC_DATA_DIR = "C:\netsync\agent2"
# Device credentials come from `pair` only — never set manually.
