# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # server-side only — never ship to agents
SUPABASE_JWT_SECRET=         # legacy HS256 projects only; ES256 uses JWKS

# "memory" for local dev/tests, "supabase" for production
DEVICE_STORE=memory

# JSON list of allowed browser origins (add your Vercel domain for prod)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000", "https://netsyncai.vercel.app"]

# AI (Phase 5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

DEBUG=false
